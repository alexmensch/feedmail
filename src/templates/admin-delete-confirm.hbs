<div class="inline-confirm" role="alert">
  <span>{{message}}</span>
  <div class="inline-confirm__actions">
    <form method="POST" action="{{confirmAction}}">
      <button type="submit" class="btn-small btn-danger"
        {{#if htmxPost}}hx-post="{{htmxPost}}" hx-target="{{htmxTarget}}" hx-swap="{{htmxSwap}}"{{/if}}>Confirm</button>
    </form>
    <button type="button" class="btn-small" data-confirm-cancel>Cancel</button>
  </div>
  {{!-- The cancel control is restored on "Cancel" via cloneNode in admin.js (never parsed from a string), and every field below is Handlebars-escaped — so it is not an XSS sink. --}}
  <template data-cancel-restore><button type="button" class="{{cancelClass}}" hx-get="{{cancelHxGet}}" hx-target="{{cancelHxTarget}}" hx-swap="innerHTML">{{cancelLabel}}</button></template>
</div>