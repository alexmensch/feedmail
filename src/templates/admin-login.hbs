{{#> admin-auth-layout pageTitle="Sign in"}}
{{#*inline "content"}}

<h1>Sign in</h1>

{{#if error}}
<div class="feedback" data-variant="error" role="alert">{{error}}</div>
{{/if}}

<div id="passkey-error" class="feedback" data-variant="error" role="alert" hidden><strong></strong></div>

{{#if hasPasskeys}}
<div id="passkey-login" class="stack" data-gap="xs">
  <button type="button" id="passkey-btn" class="btn-primary">Sign in with passkey</button>
  <p class="text-muted">Or use a magic link:</p>
</div>
{{/if}}

<form method="POST" action="/admin/login" class="stack" data-gap="xs">
  <div class="form-field">
    <label for="email">Email address</label>
    <input type="email" id="email" name="email" required {{#unless hasPasskeys}}autofocus{{/unless}}>
  </div>
  {{#if redirect}}
  <input type="hidden" name="redirect" value="{{redirect}}">
  {{/if}}
  <div>
    <button type="submit">Send sign-in link</button>
  </div>
</form>

{{#if hasPasskeys}}
<script src="/admin/passkeys.js"></script>
{{/if}}

{{/inline}}
{{/admin-auth-layout}}