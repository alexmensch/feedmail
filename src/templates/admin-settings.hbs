{{#> admin-layout pageTitle="Settings" activePage="settings"}}
{{#*inline "content"}}

<h1>Settings</h1>

{{#if error}}
<div class="feedback" data-variant="error" role="alert">{{error}}</div>
{{/if}}

{{#if success}}
<div class="feedback" data-variant="success" role="status">{{success}}</div>
{{/if}}

<div id="register-error" class="feedback" data-variant="error" role="alert" hidden><strong></strong></div>
<div id="register-success" class="feedback" data-variant="success" role="alert" hidden><strong></strong></div>

<h2>Passkeys</h2>

<div id="passkey-list">
{{#if credentials.length}}
<table class="table">
  <thead>
    <tr><th>Name</th><th>Registered</th><th>Actions</th></tr>
  </thead>
  <tbody>
    {{#each credentials}}
    <tr>
      <td>
        <span id="name-display-{{this.credential_id}}">{{#if this.name}}{{this.name}}{{else}}Unnamed passkey{{/if}}</span>
        <form method="POST" action="/admin/passkeys/{{this.credential_id}}/rename" class="cluster"
          hx-post="/admin/passkeys/{{this.credential_id}}/rename" hx-target="#passkey-list" hx-swap="innerHTML">
          <input type="text" name="name" value="{{this.name}}" maxlength="100" placeholder="Passkey name" required>
          <button type="submit" class="btn-small">Rename</button>
        </form>
      </td>
      <td>{{formatDate this.created_at}}</td>
      <td>
        <div id="passkey-delete-{{this.credential_id}}">
          <button type="button" class="btn-small btn-danger"
            hx-get="/admin/passkeys/{{this.credential_id}}/delete/confirm" hx-target="#passkey-delete-{{this.credential_id}}" hx-swap="innerHTML">Delete</button>
        </div>
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>
{{else}}
<p class="text-muted">No passkeys registered yet.</p>
{{/if}}
</div>

<h2>Register New Passkey</h2>
<div id="register-section" class="stack" data-gap="xs">
  <div class="form-field">
    <label for="passkey-name">Passkey name (e.g., "MacBook Pro", "iPhone")</label>
    <input type="text" id="passkey-name" maxlength="100" placeholder="My device">
  </div>
  <div>
    <button type="button" id="register-btn" class="btn-primary">Register passkey</button>
  </div>
</div>

<script src="/admin/passkeys.js"></script>

{{/inline}}
{{/admin-layout}}